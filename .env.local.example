# Google OAuth 2.0 credentials
# Get these from https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth redirect URI (must match Google Cloud Console setting)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Session encryption key (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=generate-a-32-char-or-longer-random-string

# Base URL for share links
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: Google API key for public read-only access to shared Drive files
# Only needed for the /lite/view/[folderId] page to work without OAuth
GOOGLE_API_KEY=your-api-key

# Optional: shared-link access-code throttling via Upstash Redis / Vercel KV REST API
# When unset, local development still works but failed shared-link attempts are not rate limited.
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
